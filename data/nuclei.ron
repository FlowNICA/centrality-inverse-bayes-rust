// Nucleus parameters from oxy-glauber (https://github.com/FlowNICA/oxy-glauber,
// data/nuclei.ron), licensed under GPL-3.0. Copied unchanged below this header.
//
// Here they define the density profiles of the optical Glauber model (impact_parameter:
// Glauber(...) in config.ron); the profiles FromFile and FromGraph have no analytic
// density and cannot be used there.
//
// Nucleus configurations used by `TGlauNucleus::new` (see `src/nucleus.rs`).
//
// Each entry maps a nucleus name to its parameters. Omitted fields take these defaults:
//   r, a, w, r2, a2, w2, beta2, beta3, beta4, gamma, r0, r1, r2_factor: 0.0
//   max_r: 15.0, recenter: 1, smax: 99.0
// `n` (mass number A), `z` (charge) and `profile` are required.
// `r0`/`r1`/`r2_factor` are the reweighting coefficients of the *rw profiles.
// `profile` is a `DensityProfile` variant name.
//
// `profile: HardSphere` is a uniform density with a sharp edge at radius `r`
// (rho = 1 for r <= R, 0 beyond; `a` and `w` are unused), e.g.:
//   "PbHS": (n: 208, z: 82, r: 7.11, profile: HardSphere),
//
// `profile: FromFile` takes the nucleon positions from a file given by the `file`
// parameter (a path, relative to the working directory the program is run from):
//   "MyO16": (n: 16, z: 8, profile: FromFile, file: "o16_configurations.dat"),
// The file holds one nucleus configuration per line: `x y z` in fm for each of the n
// nucleons (3n numbers), or `x y z isospin` (4n numbers, isospin 1 = proton,
// 0 = neutron; without it, protons are assigned at random according to z). Blank lines
// and lines starting with `#` are skipped. Each event uses a randomly chosen
// configuration in a random orientation. The FromFile entries below have no `file`
// yet: using them is an error until one is added.
//
// This file is embedded in the binary at compile time; rebuild after editing it.
{
    // Protons
    "p": (n: 1, z: 1, r: 0.234, profile: ProtonExp),
    "pi": (n: 1, z: 1, r: 0.234, profile: ProtonExp),
    "pg": (n: 1, z: 1, r: 0.514, profile: ProtonGaussian),
    "pdg": (n: 1, z: 1, r: 1.0, profile: ProtonDGaussian),
    // Deuteron
    "dpf": (n: 2, z: 1, r: 0.01, a: 0.5882, profile: WoodsSaxon3PF),
    "dh": (n: 2, z: 1, r: 0.2283, a: 1.1765, profile: Hulthen),
    "d": (n: 2, z: 1, r: 0.2283, a: 1.1765, profile: HulthenConstrained),
    // Light nuclei from files
    "He3": (n: 3, z: 1, profile: FromFile),
    "H3": (n: 3, z: 2, profile: FromFile),
    "He4": (n: 4, z: 2, profile: FromFile),
    "C": (n: 12, z: 6, profile: FromFile),
    // Nitrogen
    "Npar": (n: 14, z: 7, r: 2.570, a: 0.0572, w: -0.0180, profile: WoodsSaxon3PF),
    // Oxygen
    "O": (n: 16, z: 8, profile: FromFile),
    "Opar": (n: 16, z: 8, r: 2.608, a: 0.513, w: -0.051, max_r: 7.5, profile: WoodsSaxon3PF),
    "Opar2": (n: 16, z: 8, r: 1.850, a: 0.497, w: 0.912, max_r: 7.5, profile: WoodsSaxon3PF),
    "Osat": (n: 16, z: 8, max_r: 7.5, profile: FromGraph),
    "Odat": (n: 16, z: 8, r: 2.608, a: 0.513, w: -0.051, max_r: 7.5, profile: Oxygen1970),
    "Oho": (n: 16, z: 8, r: 1.544, a: 1.833, max_r: 7.5, profile: HarmonicOscillator),
    "Oho2": (n: 16, z: 8, r: 1.506, a: 1.819, max_r: 7.5, profile: HarmonicOscillator),
    // Neon
    "Ne": (n: 20, z: 10, r: 2.805, a: 0.571, max_r: 8.5, profile: WoodsSaxon3PF),
    "Ne2": (n: 20, z: 10, r: 2.740, a: 0.572, max_r: 8.5, profile: WoodsSaxon3PF),
    "Ne3": (n: 20, z: 10, r: 2.791, a: 0.698, w: -0.168, max_r: 8.5, profile: WoodsSaxon3PF),
    "NeTr2": (n: 20, z: 10, r: 2.8, a: 0.57, beta2: 0.721, max_r: 10.0, profile: DeformedTF2),
    "NeTr3": (n: 20, z: 10, r: 2.7243, a: 0.4982, beta2: 0.4899, beta3: 0.2160, beta4: 0.3055, gamma: 0.0, max_r: 10.0, profile: DeformedBox),
    // Aluminum
    "Al": (n: 27, z: 13, r: 3.34, a: 0.580, beta2: -0.448, beta4: 0.239, max_r: 10.0, profile: DeformedTF2),
    // Silicon
    "Si": (n: 28, z: 14, r: 3.34, a: 0.580, w: -0.233, max_r: 10.0, profile: WoodsSaxon3PF),
    "Si2": (n: 28, z: 14, r: 3.34, a: 0.580, beta2: -0.478, beta4: 0.250, max_r: 10.0, profile: DeformedTF2),
    // Sulfur
    "S": (n: 32, z: 16, r: 2.54, a: 2.191, w: 0.16, max_r: 10.0, profile: WoodsSaxon3PG),
    // Argon
    "Ar": (n: 40, z: 18, r: 3.53, a: 0.542, max_r: 10.0, profile: WoodsSaxon3PF),
    // Calcium
    "Ca": (n: 40, z: 20, r: 3.766, a: 0.586, w: -0.161, max_r: 10.0, profile: WoodsSaxon3PF),
    // Nickel
    "Ni": (n: 58, z: 28, r: 4.309, a: 0.517, w: -0.1308, max_r: 10.0, profile: WoodsSaxon3PF),
    // Copper
    "Cu": (n: 63, z: 29, r: 4.20, a: 0.596, max_r: 10.0, profile: WoodsSaxon3PF),
    "Curw": (n: 63, z: 29, r: 4.20, a: 0.596, max_r: 10.0, r0: 1.00898, r1: -0.000790403, r2_factor: -0.000389897, profile: Reweighted),
    "Cu2": (n: 63, z: 29, r: 4.20, a: 0.596, beta2: 0.162, beta4: -0.006, max_r: 10.0, profile: DeformedTF2),
    "Cu2rw": (n: 63, z: 29, r: 4.20, a: 0.596, beta2: 0.162, beta4: -0.006, max_r: 10.0, r0: 1.01269, r1: -0.00298083, r2_factor: -9.97222e-05, profile: DeformedReweighted),
    "CuHN": (n: 63, z: 29, r: 4.28, a: 0.5, max_r: 10.0, profile: WoodsSaxon3PF),
    // Niobium
    "Nb93LB": (n: 93, z: 41, r: 4.9853, a: 0.5234, profile: WoodsSaxon3PF),
    // Zirconium
    "Zr96LB": (n: 96, z: 40, r: 5.0212, a: 0.5234, profile: WoodsSaxon3PF),
    // Ruthenium
    "Ru96LB": (n: 96, z: 44, r: 5.0845, a: 0.5234, profile: WoodsSaxon3PF),
    // Silver
    "Ag107LB": (n: 107, z: 47, r: 5.3006, a: 0.5234, profile: WoodsSaxon3PF),
    "Ag109LB": (n: 109, z: 47, r: 5.3306, a: 0.5234, profile: WoodsSaxon3PF),
    "Ag107pn": (n: 107, z: 47, r: 5.2731, a: 0.4749, r2: 5.4262, a2: 0.4776, profile: ProtonNeutron3PF),
    "Ag109pn": (n: 109, z: 47, r: 5.2943, a: 0.4729, r2: 5.4762, a2: 0.4788, profile: ProtonNeutron3PF),
    "Ag107pnHFB14": (n: 107, z: 47, r: 5.2875, a: 0.4788, r2: 5.287, a2: 0.5498, profile: ProtonNeutron3PF),
    "Ag109pnHFB14": (n: 109, z: 47, r: 5.3160, a: 0.4776, r2: 5.3246, a2: 0.5593, profile: ProtonNeutron3PF),
    // Tin stable isotopes
    "Sn112": (n: 112, z: 50, r: 5.3714, a: 0.5234, profile: WoodsSaxon3PF),
    "Sn114": (n: 114, z: 50, r: 5.3943, a: 0.5234, profile: WoodsSaxon3PF),
    "Sn116": (n: 116, z: 50, r: 5.4173, a: 0.5234, profile: WoodsSaxon3PF),
    "Sn117": (n: 117, z: 50, r: 5.1241, a: 0.5234, profile: WoodsSaxon3PF),
    "Sn118": (n: 118, z: 50, r: 5.4391, a: 0.5234, profile: WoodsSaxon3PF),
    "Sn119": (n: 119, z: 50, r: 5.4431, a: 0.5234, profile: WoodsSaxon3PF),
    "Sn120": (n: 120, z: 50, r: 5.4588, a: 0.5234, profile: WoodsSaxon3PF),
    "Sn122": (n: 122, z: 50, r: 5.4761, a: 0.5234, profile: WoodsSaxon3PF),
    "Sn124": (n: 124, z: 50, r: 5.4907, a: 0.5234, profile: WoodsSaxon3PF),
    // Tin with pr3 parametrization
    // a = 2.638 / (4 ln 3)
    "Sn112pr3": (n: 112, z: 50, r: 4.962, a: 0.6003027699603992, w: 0.285, profile: WoodsSaxon3PF),
    // a = 2.636 / (4 ln 3)
    "Sn114pr3": (n: 114, z: 50, r: 4.971, a: 0.5998476503470859, w: 0.320, profile: WoodsSaxon3PF),
    // a = 2.625 / (4 ln 3)
    "Sn116pr3": (n: 116, z: 50, r: 5.062, a: 0.597344492473862, w: 0.272, profile: WoodsSaxon3PF),
    // a = 2.625 / (4 ln 3)
    "Sn117pr3": (n: 117, z: 50, r: 5.058, a: 0.597344492473862, w: 0.295, profile: WoodsSaxon3PF),
    // a = 2.623 / (4 ln 3)
    "Sn118pr3": (n: 118, z: 50, r: 5.072, a: 0.5968893728605487, w: 0.304, profile: WoodsSaxon3PF),
    // a = 2.618 / (4 ln 3)
    "Sn119pr3": (n: 119, z: 50, r: 5.100, a: 0.595751573827265, w: 0.290, profile: WoodsSaxon3PF),
    // a = 2.619 / (4 ln 3)
    "Sn120pr3": (n: 120, z: 50, r: 5.110, a: 0.5959791336339217, w: 0.292, profile: WoodsSaxon3PF),
    // a = 2.611 / (4 ln 3)
    "Sn122pr3": (n: 122, z: 50, r: 5.088, a: 0.5941586551806681, w: 0.378, profile: WoodsSaxon3PF),
    // a = 2.615 / (4 ln 3)
    "Sn124pr3": (n: 124, z: 50, r: 5.150, a: 0.5950688944072949, w: 0.311, profile: WoodsSaxon3PF),
    // Tin non-stable isotopes
    "Sn108": (n: 108, z: 50, r: 5.3274, a: 0.5234, profile: WoodsSaxon3PF),
    "Sn132": (n: 132, z: 50, r: 5.5387, a: 0.5234, profile: WoodsSaxon3PF),
    // Iodine
    "I": (n: 127, z: 53, r: 5.66, a: 0.54, profile: WoodsSaxon3PF),
    "IHS": (n: 127, z: 53, r: 5.66, profile: HardSphere),
    // Xenon
    "Xe": (n: 129, z: 54, r: 5.36, a: 0.59, max_r: 10.72, profile: WoodsSaxon3PF),
    "XeDef": (n: 129, z: 54, r: 5.36, a: 0.54, max_r: 10.72, profile: WoodsSaxon3PF),
    "XeDef2": (n: 129, z: 54, r: 5.26, a: 0.54, max_r: 10.72, profile: WoodsSaxon3PF),
    "XeDef3": (n: 129, z: 54, r: 5.46, a: 0.54, max_r: 10.72, profile: WoodsSaxon3PF),
    "XeDef4": (n: 129, z: 54, r: 5.36, a: 0.59, max_r: 10.72, profile: WoodsSaxon3PF),
    "XeDef5": (n: 129, z: 54, r: 5.36, a: 0.49, max_r: 10.72, profile: WoodsSaxon3PF),
    "XeDCM": (n: 129, z: 54, r: 5.336, a: 0.545, max_r: 6.94, profile: WoodsSaxon3PF),
    "Xes": (n: 129, z: 54, r: 5.42, a: 0.57, profile: WoodsSaxon3PF),
    "Xe2": (n: 129, z: 54, r: 5.36, a: 0.59, beta2: 0.161, beta4: -0.003, profile: DeformedTF2),
    "Xe2a": (n: 129, z: 54, r: 5.36, a: 0.59, beta2: 0.18, beta4: 0.0, profile: DeformedTF2),
    "Xerw": (n: 129, z: 54, r: 5.36, a: 0.59, r0: 1.00911, r1: -0.000722999, r2_factor: -0.0002663, profile: Reweighted),
    "Xesrw": (n: 129, z: 54, r: 5.42, a: 0.57, r0: 1.0096, r1: -0.000874123, r2_factor: -0.000256708, profile: Reweighted),
    "Xe2arw": (n: 129, z: 54, r: 5.36, a: 0.59, beta2: 0.18, beta4: 0.0, r0: 1.01246, r1: -0.0024851, r2_factor: -5.72464e-05, profile: DeformedReweighted),
    "Xe124": (n: 124, z: 54, r: 5.431, a: 0.5978, beta2: 0.212, beta4: -0.018, profile: DeformedTF2),
    "Xe124HS": (n: 124, z: 54, r: 5.431, profile: HardSphere),
    "Xe124HSurqmd": (n: 124, z: 54, r: 5.6982, profile: HardSphere), // (3./(4.*pi*0.16))**(1./3.) * A**(1./3.)
    // Cesium
    "CsI": (n: 130, z: 54, r: 5.71, a: 0.54, profile: WoodsSaxon3PF),
    "CsIHS": (n: 130, z: 54, r: 5.71, profile: HardSphere),
    "Cs": (n: 133, z: 55, r: 5.76, a: 0.54, profile: WoodsSaxon3PF),
    "CsHS": (n: 133, z: 55, r: 5.76, profile: HardSphere),
    // Tungsten
    "W184": (n: 184, z: 74, r: 6.52, a: 0.535, profile: WoodsSaxon3PF),
    "W184LB": (n: 184, z: 74, r: 6.3599, a: 0.523, profile: WoodsSaxon3PF),
    "W184HSurqmd": (n: 184, z: 74, r: 6.4993, profile: HardSphere), // (3./(4.*pi*0.16))**(1./3.) * A**(1./3.)
    "W": (n: 186, z: 74, r: 6.58, a: 0.480, profile: WoodsSaxon3PF),
    "W186LB": (n: 186, z: 74, r: 6.3839, a: 0.523, profile: WoodsSaxon3PF),
    // Gold
    "Au": (n: 197, z: 79, r: 6.38, a: 0.535, max_r: 10.0, profile: WoodsSaxon3PF),
    "Aurw": (n: 197, z: 79, r: 6.38, a: 0.535, max_r: 10.0, r0: 1.00899, r1: -0.000590908, r2_factor: -0.000210598, profile: Reweighted),
    "Au2": (n: 197, z: 79, r: 6.38, a: 0.535, beta2: -0.131, beta4: -0.031, max_r: 10.0, profile: DeformedTF2),
    "Au2rw": (n: 197, z: 79, r: 6.38, a: 0.535, beta2: -0.131, beta4: -0.031, max_r: 10.0, r0: 1.01261, r1: -0.00225517, r2_factor: -3.71513e-05, profile: DeformedReweighted),
    "AuHN": (n: 197, z: 79, r: 6.42, a: 0.44, max_r: 10.0, profile: WoodsSaxon3PF),
    "Au197LB": (n: 197, z: 79, r: 6.5541, a: 0.523, profile: WoodsSaxon3PF),
    "Au4pn": (n: 197, z: 79, r: 6.538, a: 0.465, r2: 6.794, a2: 0.483, profile: ProtonNeutron3PF),
    "Au197pnHFB14": (n: 197, z: 79, r: 6.5831, a: 0.4628, r2: 6.6604, a2: 0.5464, profile: ProtonNeutron3PF),
