    "Pb": (n: 208, z: 82, r: 6.62, a: 0.546, max_r: 10.0, profile: WoodsSaxon3PF),
    "Pbrw": (n: 208, z: 82, r: 6.62, a: 0.546, max_r: 10.0, r0: 1.00863, r1: -0.00044808, r2_factor: -0.000205872, profile: Reweighted),
